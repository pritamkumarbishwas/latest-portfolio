# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=you@example.com

# Optional: verified sender identity (defaults to "Portfolio <onboarding@resend.dev>")
# RESEND_FROM_EMAIL=Portfolio <you@yourdomain.com>

# Chatbot model provider: "groq" (default) or "openai"
CHAT_PROVIDER=groq

# Optional: override the provider's default model id
# (default: openai/gpt-oss-120b on groq, gpt-4o-mini on openai)
# CHAT_MODEL=

# Groq API key — https://console.groq.com/keys
# Server-side only for the portfolio chatbot. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# OpenAI API key — https://platform.openai.com/api-keys
# Only needed when CHAT_PROVIDER=openai.
OPENAI_API_KEY=

# Upstash Redis — https://console.upstash.com (free tier is plenty)
# Sliding-window rate limiting for /api/chat: 10 requests/minute, 50/day per IP.
# Required in production: without it the chat route fails closed (503).
# In development it falls back to an in-memory limiter with a console warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public origin of this site — e.g. https://yourdomain.com (no trailing slash needed)
# Allowlisted alongside localhost for /api/chat. Required in production:
# if unset, the route only accepts localhost and logs a warning.
SITE_URL=

# Kill switch: set to "false" to disable the chatbot entirely
# (route returns 503 and the launcher button is hidden). Unset = enabled.
# CHAT_ENABLED=false
